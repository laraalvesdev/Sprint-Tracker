  id          String          @id @default(uuid())
  ownerId     String
  title       String
  description String?
  visibility  BoardVisibility @default(PRIVATE)
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
